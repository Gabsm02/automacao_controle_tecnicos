                  '#ff9200',
                  false
                ),

                criarDatasetEvolucao(
                  'P2 Regional',
                  'regionalP2',
                  '#0066ff',
                  true
                )
              ]
            },

            options: {
              responsive: true,
              maintainAspectRatio: false,

              animation: {
                duration: 450
              },

              interaction: {
                mode: 'index',
                intersect: false
              },

              plugins: {
                legend: {
                  display: true,
                  position: 'bottom',

                  labels: {
                    usePointStyle: true,
                    boxWidth: 9,
                    padding: 18
                  }
                },

                tooltip: {
                  callbacks: {
                    label: function (context) {
                      return (
                        context.dataset.label +
                        ': ' +
                        formatarPercentual(
                          context.raw
                        )
                      );
                    }
                  }
                }
              },

              scales: {
                x: {
                  grid: {
                    display: false
                  },

                  ticks: {
                    color: '#6c757d',
                    maxRotation: 45,
                    minRotation: 0
                  }
                },

                y: {
                  beginAtZero: true,
                  suggestedMax: 100,

                  grid: {
