        Number(causas.total || 0)
          .toLocaleString('pt-BR')
      }}
      registro(s)

      @if(Number(causas.total || 0) > 0)
        · Página {{ causas.currentPage }}
        de {{ causas.lastPage }}
      @endif
    </span>
  </div>

  @if(causas.length === 0)
    <div class="baseline-empty">
      <i
        class="fa fa-search"
        aria-hidden="true"
      ></i>

      Nenhum evento encontrado para os filtros selecionados.
    </div>
  @else
    <div class="baseline-table-responsive">
      <table class="table table-hover baseline-table">
        <thead>
          <tr>
            <th>Dia</th>
            <th>Evento</th>
            <th>Tipo de falha</th>
            <th>UF</th>
            <th>Município</th>
            <th>DDD</th>
            <th>Sigla</th>
            <th>Prioridade</th>
            <th>Responsabilidade</th>
            <th>Justificativa</th>
            <th>Descrição</th>
          </tr>
        </thead>

        <tbody>
          @each(causa in causas)
            <tr>
              <td class="baseline-table-nowrap">
                {{ causa.dia_formatado || causa.dia || '-' }}
              </td>

              <td class="baseline-table-nowrap">
                <strong>
                  {{ causa.evento || '-' }}
                </strong>
              </td>

              <td class="baseline-table-failure">
                {{ causa.tipo_falha_rede || '-' }}
              </td>

              <td>
                <strong>
                  {{ causa.uf || '-' }}
                </strong>
              </td>

              <td>
                {{ causa.municipio || '-' }}
              </td>

              <td>
                {{ causa.ddd || '-' }}
              </td>

              <td class="baseline-table-nowrap">
                {{ causa.sigla || '-' }}
              </td>

              <td>
                @if(causa.prioridade === 'P1')
                  <span class="baseline-tag baseline-tag-p1">
                    P1
                  </span>
                @elseif(causa.prioridade === 'P2')
                  <span class="baseline-tag baseline-tag-p2">
                    P2
                  </span>
                @elseif(causa.prioridade === 'P1+P2')
                  <span class="baseline-tag baseline-tag-p1p2">
                    P1+P2
                  </span>
                @else
                  {{ causa.prioridade || '-' }}
                @endif
              </td>

              <td>
                @if(causa.responsabilidade === 'Terceira')
                  <span class="baseline-tag baseline-tag-terceira">
                    Terceira
                  </span>
                @elseif(causa.responsabilidade === 'Regional')
                  <span class="baseline-tag baseline-tag-regional">
                    Regional
                  </span>
                @else
                  {{ causa.responsabilidade || '-' }}
                @endif
              </td>

              <td>
                {{ causa.justificativas || '-' }}
              </td>

              <td class="baseline-table-description">
                {{ causa.descricao_justificativa || '-' }}
              </td>
            </tr>
          @endeach
        </tbody>
      </table>
    </div>
  @endif
</div>
@if(ultimaPagina > 1)
  <nav
    class="baseline-pagination"
    aria-label="Paginação das causas ofensoras"
  >
    @if(paginaAtual > 1)
      <a
        href="{{ causas.getUrl(paginaAtual - 1) }}"
        aria-label="Ir para a página anterior"
        rel="prev"
      >
        <i
          class="fa fa-chevron-left"
          aria-hidden="true"
        ></i>

        <span>Anterior</span>
      </a>
    @else
      <span
        class="disabled"
        aria-disabled="true"
      >
        <i
          class="fa fa-chevron-left"
          aria-hidden="true"
        ></i>

        <span>Anterior</span>
      </span>
    @endif

    @if(paginaInicial > 1)
      <a
        href="{{ causas.getUrl(1) }}"
        aria-label="Ir para a página 1"
      >
        1
      </a>

      @if(paginaInicial > 2)
        <span
          class="ellipsis"
          aria-hidden="true"
        >
          ...
        </span>
      @endif
    @endif

    @each(
      link in causas.getUrlsForRange(
        paginaInicial,
        paginaFinal
      )
    )
      @if(link.isActive)
        <span
          class="active"
          aria-current="page"
        >
          {{ link.page }}
        </span>
      @else
        <a
          href="{{ link.url }}"
          aria-label="Ir para a página {{ link.page }}"
        >
          {{ link.page }}
        </a>
      @endif
    @endeach

    @if(paginaFinal < ultimaPagina)
      @if(paginaFinal < ultimaPagina - 1)
        <span
          class="ellipsis"
          aria-hidden="true"
        >
          ...
        </span>
      @endif

      <a
        href="{{ causas.getUrl(ultimaPagina) }}"
        aria-label="Ir para a última página, página {{ ultimaPagina }}"
      >
        {{ ultimaPagina }}
      </a>
    @endif

    @if(paginaAtual < ultimaPagina)
      <a
        href="{{ causas.getUrl(paginaAtual + 1) }}"
        aria-label="Ir para a próxima página"
        rel="next"
      >
        <span>Próxima</span>

        <i
          class="fa fa-chevron-right"
          aria-hidden="true"
        ></i>
      </a>
    @else
      <span
        class="disabled"
        aria-disabled="true"
      >
        <span>Próxima</span>

        <i
          class="fa fa-chevron-right"
          aria-hidden="true"
        ></i>
      </span>
    @endif
  </nav>
@endif

<script>
  (function () {
    'use strict';

    const dadosEvolucao =
      {{{ stringify(evolucao || []) }}};

    const dadosRankingUf =
      {{{ stringify(rankingUfGrafico || []) }}};

    const dadosRankingDdd =
      {{{ stringify(rankingDddGrafico || []) }}};

    const dadosGapUf =
      {{{ stringify(gapUfRegional || []) }}};

    const dadosCausasTipoFalha =
      {{{ stringify(causasPorTipoFalha || []) }}};

    const dadosCausasResponsabilidade =
      {{{ stringify(causasPorResponsabilidade || []) }}};

    const dadosCausasPrioridade =
      {{{ stringify(causasPorPrioridade || []) }}};

    let graficoEvolucaoBaseline = null;
    let graficoRankingUf = null;
    let graficoRankingDdd = null;
    let graficoGapUfRegional = null;
    let graficoCausasTipoFalha = null;
    let graficoCausasResponsabilidade = null;
    let graficoCausasPrioridade = null;

    function normalizarNumeroOuNull(valor) {
      if (
        valor === null ||
        valor === undefined ||
        valor === ''
      ) {
        return null;
      }

      let valorNormalizado = valor;

      if (typeof valor === 'string') {
        valorNormalizado =
          valor
            .trim()
            .replace(',', '.');
      }

      const numero =
        Number(valorNormalizado);

      return Number.isFinite(numero)
        ? numero
        : null;
    }

    function formatarPercentual(valor) {
      const numero =
        normalizarNumeroOuNull(valor);

      if (numero === null) {
        return '-';
      }

      return (
        numero.toLocaleString(
          'pt-BR',
          {
            minimumFractionDigits: 1,
            maximumFractionDigits: 1
          }
        ) +
        '%'
      );
    }

    function formatarQuantidade(valor) {
      const numero =
        normalizarNumeroOuNull(valor);

      if (numero === null) {
        return '0';
      }

      return numero.toLocaleString(
        'pt-BR',
        {
          maximumFractionDigits: 0
        }
      );
    }

    function formatarPontosPercentuais(valor) {
      const numero =
        normalizarNumeroOuNull(valor);

      if (numero === null) {
        return '-';
      }

      return (
        (
          numero >= 0
            ? '+'
            : ''
        ) +
        numero.toLocaleString(
          'pt-BR',
          {
            minimumFractionDigits: 1,
            maximumFractionDigits: 1
          }
        ) +
        ' p.p.'
      );
    }

    function destruirGraficoExistente(
      canvas,
      instancia
    ) {
      if (
        instancia &&
        typeof instancia.destroy ===
          'function'
      ) {
        instancia.destroy();
      }

      if (
        typeof Chart === 'undefined' ||
        !canvas
      ) {
        return;
      }

      const graficoExistente =
        Chart.getChart(canvas);

      if (
        graficoExistente &&
        graficoExistente !== instancia
      ) {
        graficoExistente.destroy();
      }
    }

    function criarDatasetEvolucao(
      label,
      campo,
      cor,
      tracejado
    ) {
      return {
        label: label,

        data:
          dadosEvolucao.map(
            function (item) {
              return normalizarNumeroOuNull(
                item[campo]
              );
            }
          ),

        borderColor: cor,
        backgroundColor: cor,
        pointBackgroundColor: cor,
        pointBorderColor: '#ffffff',
        pointBorderWidth: 2,
        pointRadius: 4,
        pointHoverRadius: 6,
        borderWidth: 3,

        borderDash:
          tracejado
            ? [7, 5]
            : [],

        tension: 0.35,
        spanGaps: false,
        fill: false
      };
    }

        
    function obterOpcoesBarrasPercentuais() {
  return {
    responsive: true,
    maintainAspectRatio: false,
    indexAxis: 'x',

    animation: {
      duration: 450
    },

    interaction: {
      mode: 'index',
      intersect: false
    },

    plugins: {
      legend: {
        display: true,
        position: 'bottom',

        labels: {
          usePointStyle: true,
          boxWidth: 9,
          padding: 18
        }
      },

      tooltip: {
        callbacks: {
          label: function (context) {
            return (
              context.dataset.label +
              ': ' +
              formatarPercentual(
                context.raw
              )
            );
          }
        }
      }
    },

    scales: {
      x: {
        grid: {
          display: false
        },

        title: {
          display: true,
          text: 'Localidade'
        },

        ticks: {
          color: '#6c757d',
          autoSkip: false,
          maxRotation: 45,
          minRotation: 0
        }
      },

      y: {
        beginAtZero: true,
        suggestedMax: 100,

        grid: {
          color:
            'rgba(108, 117, 125, 0.12)'
        },

        title: {
          display: true,
          text: 'SLA (%)'
        },

        ticks: {
          color: '#6c757d',

          callback: function (valor) {
            return valor + '%';
          }
        }
      }
    }
  };
}
