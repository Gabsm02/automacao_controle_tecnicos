@layout('main')

@section('content')

<style>
  :root {
    --baseline-primary: #660099;
    --baseline-primary-dark: #4d0075;
    --baseline-pink: #cb2166;
    --baseline-blue: #0066ff;
    --baseline-orange: #ff9200;
    --baseline-green: #28a745;
    --baseline-yellow: #ffb703;
    --baseline-red: #dc3545;
    --baseline-gray-100: #f8f9fa;
    --baseline-gray-200: #e9ecef;
    --baseline-gray-600: #6c757d;
    --baseline-gray-800: #343a40;
    --baseline-white: #ffffff;
  }

  .container {
    max-width: 100%;
  }

  /* ============================================================
     CABEÇALHO
  ============================================================ */

  .baseline-page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    padding: 1.5rem 2rem;
    color: #ffffff;
    border-radius: 12px;
    background:
      linear-gradient(
        135deg,
        var(--baseline-primary) 0%,
        var(--baseline-pink) 100%
      );
    box-shadow:
      0 4px 15px rgba(102, 0, 153, 0.25);
  }

  .baseline-page-header-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .baseline-page-header h1 {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    color: #ffffff;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .baseline-page-header .subtitle {
    margin-top: 0.25rem;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.9rem;
  }

  .baseline-page-header-period {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    padding: 0.55rem 0.9rem;
    color: var(--baseline-primary);
    border-radius: 8px;
    background: #ffffff;
    font-size: 0.82rem;
    font-weight: 700;
    box-shadow:
      0 4px 12px rgba(33, 0, 50, 0.18);
  }

  /* ============================================================
     TÍTULOS DE SEÇÃO
  ============================================================ */

  .baseline-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 0 0 0.85rem;
  }

  .baseline-section-title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    color: var(--baseline-primary);
    font-size: 1rem;
    font-weight: 700;
  }

  .baseline-section-description {
    color: var(--baseline-gray-600);
    font-size: 0.78rem;
  }

  /* ============================================================
     FILTROS
  ============================================================ */

  .baseline-filter-panel {
    margin-bottom: 1.5rem;
    padding: 1.25rem;
    border-radius: 12px;
    background: #ffffff;
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .baseline-filter-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    color: var(--baseline-primary);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .baseline-filter-grid {
    display: grid;
    grid-template-columns:
      minmax(210px, 2fr)
      repeat(5, minmax(130px, 1fr))
      auto;
    gap: 0.75rem;
    align-items: end;
  }

  .baseline-filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .baseline-filter-group label {
    margin: 0;
    color: var(--baseline-gray-600);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  .baseline-filter-group .form-control {
    width: 100%;
    min-height: 38px;
    border: 1px solid #d9d0df;
    border-radius: 6px;
    background-color: #ffffff;
    font-size: 0.82rem;
  }

  .baseline-filter-group .form-control:focus {
    border-color: var(--baseline-primary);
    box-shadow:
      0 0 0 0.2rem rgba(102, 0, 153, 0.12);
  }

  .baseline-filter-buttons {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .baseline-btn-search,
  .baseline-btn-clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 38px;
    padding: 0.45rem 1rem;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .baseline-btn-search {
    color: #ffffff;
    border: 1px solid var(--baseline-primary);
    background: var(--baseline-primary);
  }

  .baseline-btn-search:hover {
    color: #ffffff;
    border-color: var(--baseline-pink);
    background: var(--baseline-pink);
    transform: translateY(-1px);
  }

  .baseline-btn-clear {
    color: var(--baseline-primary);
    border: 1px solid #d7c8df;
    background: #ffffff;
    text-decoration: none;
  }

  .baseline-btn-clear:hover {
    color: var(--baseline-primary);
    background: #f8f3fb;
    text-decoration: none;
    transform: translateY(-1px);
  }

  /* ============================================================
     KPIs
  ============================================================ */

  .baseline-kpi-grid {
    display: grid;
    grid-template-columns:
      repeat(auto-fit, minmax(175px, 1fr));
    gap: 16px;
    margin-bottom: 1.5rem;
  }

  .baseline-kpi-card {
    position: relative;
    overflow: hidden;
    min-height: 118px;
    padding: 18px;
    border-left: 4px solid var(--baseline-primary);
    border-radius: 12px;
    background: #ffffff;
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.08);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .baseline-kpi-card:hover {
    transform: translateY(-3px);
    box-shadow:
      0 8px 20px rgba(0, 0, 0, 0.13);
  }

  .baseline-kpi-card::after {
    position: absolute;
    right: -22px;
    bottom: -30px;
    width: 84px;
    height: 84px;
    content: "";
    border-radius: 50%;
    background: rgba(102, 0, 153, 0.05);
  }

  .baseline-kpi-card.primary {
    border-left-color: var(--baseline-primary);
  }

  .baseline-kpi-card.pink {
    border-left-color: var(--baseline-pink);
  }

  .baseline-kpi-card.blue {
    border-left-color: var(--baseline-blue);
  }

  .baseline-kpi-card.orange {
    border-left-color: var(--baseline-orange);
  }

  .baseline-kpi-card.success {
    border-left-color: var(--baseline-green);
  }

  .baseline-kpi-card.warning {
    border-left-color: var(--baseline-yellow);
  }

  .baseline-kpi-card.danger {
    border-left-color: var(--baseline-red);
  }

  .baseline-kpi-card.highlight {
    color: #ffffff;
    border-left: 0;
    background:
      linear-gradient(
        135deg,
        var(--baseline-primary) 0%,
        var(--baseline-pink) 100%
      );
  }

  .baseline-kpi-card.highlight::after {
    background: rgba(255, 255, 255, 0.12);
  }

  .baseline-kpi-label {
    position: relative;
    z-index: 1;
    display: block;
    min-height: 30px;
    color: var(--baseline-gray-600);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.35px;
    text-transform: uppercase;
  }

  .baseline-kpi-card.highlight .baseline-kpi-label {
    color: rgba(255, 255, 255, 0.82);
  }

  .baseline-kpi-value {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 8px;
    color: var(--baseline-primary);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
  }

  .baseline-kpi-card.highlight .baseline-kpi-value {
    color: #ffffff;
  }

  .baseline-kpi-value small {
    font-size: 0.9rem;
    font-weight: 600;
    opacity: 0.78;
  }

  .baseline-status-dot {
    display: inline-block;
    width: 11px;
    height: 11px;
    flex: 0 0 11px;
    border-radius: 50%;
    box-shadow:
      0 0 0 4px rgba(0, 0, 0, 0.05);
  }

/* ============================================================
   LAYOUT EXECUTIVO DOS GRÁFICOS
============================================================ */

.baseline-panel {
  min-width: 0;
  overflow: hidden;
  border-radius: 12px;
  background: #ffffff;
  box-shadow:
    0 2px 8px rgba(0, 0, 0, 0.08);
}

.baseline-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  min-height: 74px;
  padding: 0.85rem 1rem;
  border-bottom: 1px solid var(--baseline-gray-200);
  background: var(--baseline-gray-100);
}

.baseline-panel-title {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  margin: 0;
  color: var(--baseline-primary);
  font-size: 0.88rem;
  font-weight: 700;
}

.baseline-panel-subtitle {
  margin-top: 0.2rem;
  color: var(--baseline-gray-600);
  font-size: 0.72rem;
  line-height: 1.4;
}

/* ============================================================
   EVOLUÇÃO MENSAL EM TODA A LARGURA
============================================================ */

.baseline-evolution-panel {
  width: 100%;
  margin-bottom: 1.5rem;
}

.baseline-chart-wrapper-evolution {
  position: relative;
  width: 100%;
  height: 460px;
  padding: 20px;
}

/* ============================================================
   TRÊS GRÁFICOS COMPARATIVOS LADO A LADO
============================================================ */

.baseline-comparative-grid {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
  gap: 1.25rem;
  align-items: stretch;
  width: 100%;
  margin-bottom: 1.5rem;
}

.baseline-comparative-grid > .baseline-panel {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  height: 100%;
}

.baseline-comparative-grid .baseline-panel-header {
  flex: 0 0 auto;
}

.baseline-chart-wrapper-comparative {
  position: relative;
  flex: 1 1 auto;
  width: 100%;
  height: 400px;
  min-height: 400px;
  padding: 18px;
}

/* ============================================================
   TABELAS DE RANKING COM LARGURAS IGUAIS
============================================================ */

.baseline-ranking-tables-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 1.25rem;
  align-items: start;
  width: 100%;
  margin-bottom: 1.5rem;
}

.baseline-ranking-tables-grid > .baseline-panel {
  width: 100%;
  min-width: 0;
}

.baseline-ranking-tables-grid .baseline-table-responsive {
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
}

/*
 * A tabela de DDD possui mais colunas.
 * Ela continua com rolagem horizontal dentro do próprio painel,
 * sem aumentar a largura do painel.
 */
.baseline-ranking-tables-grid .baseline-table {
  width: 100%;
}

/* ============================================================
   GRÁFICOS DE CAUSAS OFENSORAS
============================================================ */

.baseline-cause-charts-grid {
  display: grid;
  grid-template-columns:
    minmax(0, 1.5fr)
    minmax(280px, 0.75fr)
    minmax(280px, 0.75fr);
  gap: 1.25rem;
  align-items: stretch;
  width: 100%;
  margin-bottom: 1.5rem;
}

.baseline-cause-charts-grid > .baseline-panel {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.baseline-chart-wrapper-ranking {
  position: relative;
  width: 100%;
  height: 420px;
  padding: 20px;
}

.baseline-chart-wrapper-small {
  position: relative;
  width: 100%;
  height: 340px;
  padding: 20px;
}

.baseline-chart-legend-note {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  flex-wrap: wrap;
  color: var(--baseline-gray-600);
  font-size: 0.7rem;
}

/* ============================================================
   RESPONSIVIDADE
============================================================ */

/*
 * Mantém os três gráficos comparativos lado a lado
 * em computadores e notebooks.
 */
@media (min-width: 992px) {
  .baseline-comparative-grid {
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }

  .baseline-comparative-grid > .baseline-panel {
    grid-column: auto;
  }

  .baseline-ranking-tables-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}

/*
 * Em tablets, os gráficos e tabelas ficam um abaixo do outro.
 * Isso evita painéis apertados e textos ilegíveis.
 */
@media (max-width: 991.98px) {
  .baseline-comparative-grid,
  .baseline-ranking-tables-grid,
  .baseline-cause-charts-grid {
    grid-template-columns: 1fr;
  }

  .baseline-comparative-grid > .baseline-panel,
  .baseline-cause-charts-grid > .baseline-panel {
    grid-column: auto;
  }

  .baseline-chart-wrapper-evolution {
    height: 400px;
  }

  .baseline-chart-wrapper-comparative {
    height: 380px;
    min-height: 380px;
  }
}

/* Ajustes para celulares */

@media (max-width: 767.98px) {
  .baseline-panel-header {
    min-height: auto;
    align-items: flex-start;
    flex-direction: column;
  }

  .baseline-chart-wrapper-evolution {
    height: 340px;
    padding: 12px;
  }

  .baseline-chart-wrapper-comparative {
    height: 360px;
    min-height: 360px;
    padding: 12px;
  }

  .baseline-chart-wrapper-ranking,
  .baseline-chart-wrapper-small {
    height: 360px;
    padding: 12px;
  }
}

</style>

<link rel="stylesheet" href="/css/bootstrap-select.min.css">
<script src="/js/bootstrap-select.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>

<div class="baseline-page-header">
  
  <div class="baseline-page-header-content">
    <h1>
      <i
        class="fa fa-chart-line"
        aria-hidden="true"
      ></i>

      <span>Guardião Baseline</span>
    </h1>

    <div class="subtitle">
      Indicadores de SLA e causas ofensoras da Regional Nordeste
    </div>
  </div>

  @if(periodoRef)
    <div class="baseline-page-header-period">
      <i
        class="fa fa-calendar-alt"
        aria-hidden="true"
      ></i>

      <span>
        Período de referência:
        <strong>{{ periodoRef }}</strong>
      </span>

      @if(ufSelecionada)
        <span>
          · UF:
          <strong>{{ ufSelecionada }}</strong>
        </span>
      @endif
    </div>
  @endif
</div>

<div class="baseline-filter-panel">
  <div class="baseline-filter-title">
    <i
      class="fa fa-filter"
      aria-hidden="true"
    ></i>

    <span>Filtros do dashboard</span>
  </div>

  <form
        id="filtros-inline"
        method="GET"
        action="/guardiao-baseline"
      >
    <div class="baseline-filter-grid">
      <div class="baseline-filter-group">
        <label for="busca">
          Evento, município ou sigla
        </label>

        <input
          type="text"
          id="busca"
          name="busca"
          class="form-control"
          maxlength="200"
          autocomplete="off"
          placeholder="Pesquisar evento, município ou sigla"
          value="{{ filtros.busca || '' }}"
        >
      </div>

      <div class="baseline-filter-group">
        <label for="periodo">
          Período
        </label>

        <input
          type="text"
          id="periodo"
          name="periodo"
          class="form-control"
          maxlength="7"
          inputmode="numeric"
          autocomplete="off"
          placeholder="MM/AAAA"
          value="{{ filtros.periodo || '' }}"
        >
      </div>

      <div class="baseline-filter-group">
        <label for="uf">
          UF
        </label>

        <select
          id="uf"
          name="uf"
          class="form-control"
        >
          <option value="">
            Todas as UFs
          </option>

          @each(uf in ufsValidas)
            <option
              value="{{ uf }}"
              {{ filtros.uf === uf ? 'selected' : '' }}
            >
              {{ uf }}
            </option>
          @endeach
        </select>
      </div>

      <div class="baseline-filter-group">
        <label for="ddd">
          DDD
        </label>

        <input
          type="text"
          id="ddd"
          name="ddd"
          class="form-control"
          maxlength="2"
          inputmode="numeric"
          autocomplete="off"
          placeholder="Ex.: 81"
          value="{{ filtros.ddd || '' }}"
        >
      </div>

      <div class="baseline-filter-group">
        <label for="prioridade">
          Prioridade
        </label>

        <select
          id="prioridade"
          name="prioridade"
          class="form-control"
        >
          <option value="">
            Todas
          </option>

          @each(prioridade in prioridadesValidas)
            <option
              value="{{ prioridade }}"
              {{ filtros.prioridade === prioridade ? 'selected' : '' }}
            >
              {{ prioridade }}
            </option>
          @endeach
        </select>
      </div>

      <div class="baseline-filter-group">
        <label for="responsabilidade">
          Responsabilidade
        </label>

        <select
          id="responsabilidade"
          name="responsabilidade"
          class="form-control"
        >
          <option value="">
            Todas
          </option>

          @each(responsabilidade in responsabilidadesValidas)
            <option
              value="{{ responsabilidade }}"
              {{
                filtros.responsabilidade === responsabilidade
                  ? 'selected'
                  : ''
              }}
            >
              {{ responsabilidade }}
            </option>
          @endeach
        </select>
      </div>

      <div class="baseline-filter-group">
        <label>
          Ações
        </label>

        <div class="baseline-filter-buttons">
          <button
            type="submit"
            class="btn baseline-btn-search"
          >
            <i
              class="fa fa-search"
              aria-hidden="true"
            ></i>

            <span>Buscar</span>
          </button>

          <a
              href="/guardiao-baseline"
              class="btn baseline-btn-clear"
              title="Limpar filtros"
              >
            <i
              class="fa fa-eraser"
              aria-hidden="true"
            ></i>

            <span>Limpar</span>
          </a>
        </div>
      </div>
    </div>
  </form>
</div>

<div class="baseline-section-header">
  <h2 class="baseline-section-title">
    <i
      class="fa fa-tachometer-alt"
      aria-hidden="true"
    ></i>

    <span>Resumo executivo do SLA</span>
  </h2>

  <span class="baseline-section-description">
    Indicadores da UF e do período de referência
  </span>
</div>

<div class="baseline-kpi-grid">
  <div class="baseline-kpi-card highlight">
    <span class="baseline-kpi-label">
      Baseline no período
    </span>

    <strong class="baseline-kpi-value">
      {{
        Number(kpiP1.baseline || 0)
          .toLocaleString('pt-BR')
      }}
    </strong>
  </div>

  <div class="baseline-kpi-card pink">
    <span class="baseline-kpi-label">
      SLA P1 · Terceira
    </span>

    <strong class="baseline-kpi-value">
      <span
        class="baseline-status-dot"
        style="background-color: {{ corP1Terceira }}"
        aria-hidden="true"
      ></span>

      @if(
        kpiP1.mediaTerceira !== null &&
        kpiP1.mediaTerceira !== undefined
      )
        {{ Number(kpiP1.mediaTerceira).toFixed(1) }}
        <small>%</small>
      @else
        -
      @endif
    </strong>
  </div>

  <div class="baseline-kpi-card primary">
    <span class="baseline-kpi-label">
      SLA P1 · Regional
    </span>

    <strong class="baseline-kpi-value">
      <span
        class="baseline-status-dot"
        style="background-color: {{ corP1Regional }}"
        aria-hidden="true"
      ></span>

      @if(
        kpiP1.mediaRegional !== null &&
        kpiP1.mediaRegional !== undefined
      )
        {{ Number(kpiP1.mediaRegional).toFixed(1) }}
        <small>%</small>
      @else
        -
      @endif
    </strong>
  </div>

  <div class="baseline-kpi-card orange">
    <span class="baseline-kpi-label">
      SLA P2 · Terceira
    </span>

    <strong class="baseline-kpi-value">
      <span
        class="baseline-status-dot"
        style="background-color: {{ corP2Terceira }}"
        aria-hidden="true"
      ></span>

      @if(
        kpiP2.mediaTerceira !== null &&
        kpiP2.mediaTerceira !== undefined
      )
        {{ Number(kpiP2.mediaTerceira).toFixed(1) }}
        <small>%</small>
      @else
        -
      @endif
    </strong>
  </div>

  <div class="baseline-kpi-card blue">
    <span class="baseline-kpi-label">
      SLA P2 · Regional
    </span>

    <strong class="baseline-kpi-value">
      <span
        class="baseline-status-dot"
        style="background-color: {{ corP2Regional }}"
        aria-hidden="true"
      ></span>

      @if(
        kpiP2.mediaRegional !== null &&
        kpiP2.mediaRegional !== undefined
      )
        {{ Number(kpiP2.mediaRegional).toFixed(1) }}
        <small>%</small>
      @else
        -
      @endif
    </strong>
  </div>

  <div class="baseline-kpi-card warning">
    <span class="baseline-kpi-label">
      GAP P1 · Terceira − Regional
    </span>

    <strong class="baseline-kpi-value">
      @if(
        gapRegional !== null &&
        gapRegional !== undefined
      )
        {{
          Number(gapRegional) >= 0
            ? '+'
            : ''
        }}{{ Number(gapRegional).toFixed(1) }}

        <small>p.p.</small>
      @else
        -
      @endif
    </strong>
  </div>

  <div class="baseline-kpi-card success">
    <span class="baseline-kpi-label">
      Melhor UF · Regional P1
    </span>

    <strong class="baseline-kpi-value">
      {{ melhorUf || '-' }}
    </strong>
  </div>

  <div class="baseline-kpi-card danger">
    <span class="baseline-kpi-label">
      UF crítica · Regional P1
    </span>

    <strong class="baseline-kpi-value">
      {{ ufCritica || '-' }}
    </strong>
  </div>

  <div class="baseline-kpi-card success">
    <span class="baseline-kpi-label">
      Melhor DDD · Regional P1
    </span>

    <strong class="baseline-kpi-value">
      {{ melhorDdd || '-' }}
    </strong>
  </div>

