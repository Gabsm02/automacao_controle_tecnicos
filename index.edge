function obterCorGap(valor) {
      const numero =
        normalizarNumeroOuNull(valor);

      if (numero === null) {
        return '#94a3b8';
      }

      const valorAbsoluto =
        Math.abs(numero);

      if (valorAbsoluto <= 5) {
        return '#28a745';
      }

      if (valorAbsoluto <= 10) {
        return '#ffb703';
      }

      return '#dc3545';
    }
    function inicializarGraficoGapUf() {
      const canvas =
        document.getElementById(
          'graficoGapUfRegional'
        );

      if (
        !canvas ||
        !Array.isArray(dadosGapUf) ||
        dadosGapUf.length === 0
      ) {
        return;
      }

      destruirGraficoExistente(
        canvas,
        graficoGapUfRegional
      );

      graficoGapUfRegional =
        new Chart(
          canvas,
          {
            type: 'bar',

            data: {
              labels:
                dadosGapUf.map(
                  function (item) {
                    return String(
                      item.uf || ''
                    );
                  }
                ),

              datasets: [
                {
                  label:
                    'GAP P1 Terceira - Regional',

                  data:
                    dadosGapUf.map(
                      function (item) {
                        return normalizarNumeroOuNull(
                          item.gapP1
                        );
                      }
                    ),

                  backgroundColor:
                    dadosGapUf.map(
                      function (item) {
                        return obterCorGap(
                          item.gapP1
                        );
                      }
                    ),

                  borderColor:
                    dadosGapUf.map(
                      function (item) {
                        return obterCorGap(
                          item.gapP1
                        );
                      }
                    ),

                  borderWidth: 1,
                  borderRadius: 5,
                  borderSkipped: false,
                  maxBarThickness: 48,
                  categoryPercentage: 0.72,
                  barPercentage: 0.82
                }
              ]
            },

            options: {
              responsive: true,
              maintainAspectRatio: false,
              indexAxis: 'x',

              animation: {
                duration: 450
              },

              interaction: {
                mode: 'index',
                intersect: false
              },

              plugins: {
                legend: {
                  display: false
                },

                tooltip: {
                  callbacks: {
                    label: function (context) {
                      return formatarPontosPercentuais(
                        context.raw
                      );
                    },

                    afterLabel: function (context) {
                      const item =
                        dadosGapUf[
                          context.dataIndex
                        ];

                      if (!item) {
                        return [];
                      }

                      return [
                        'Terceira: ' +
                          formatarPercentual(
                            item.terceiraP1
                          ),

                        'Regional: ' +
                          formatarPercentual(
                            item.regionalP1
                          )
                      ];
                    }
                  }
                }
              },

              scales: {
                x: {
                  grid: {
                    display: false
                  },

                  title: {
                    display: true,
                    text: 'UF'
                  },

                  ticks: {
                    color: '#6c757d',
                    autoSkip: false,
                    maxRotation: 45,
                    minRotation: 0
                  }
                },

                y: {
                  grid: {
                    color:
                      'rgba(108, 117, 125, 0.12)'
                  },

                  title: {
                    display: true,
                    text: 'Pontos percentuais'
                  },

                  ticks: {
                    color: '#6c757d',

                    callback: function (valor) {
                      return valor + ' p.p.';
                    }
                  }
                }
              }
            }
          }
        );
    }
      

    function inicializarGraficoTipoFalha() {
          const canvas =
            document.getElementById(
              'graficoCausasTipoFalha'
            );

          if (
            !canvas ||
            !Array.isArray(
              dadosCausasTipoFalha
            ) ||
            dadosCausasTipoFalha.length ===
              0
          ) {
            return;
          }

          destruirGraficoExistente(
            canvas,
            graficoCausasTipoFalha
          );

          graficoCausasTipoFalha =
            new Chart(
              canvas,
              {
                type: 'bar',

                data: {
                  labels:
                    dadosCausasTipoFalha.map(
                      function (item) {
                        return String(
                          item.label || ''
                        );
                      }
                    ),

                  datasets: [
                    {
                      label: 'Quantidade',

                      data:
                        dadosCausasTipoFalha.map(
                          function (item) {
                            return (
                              normalizarNumeroOuNull(
                                item.total
                              ) ?? 0
                            );
                          }
                        ),

                      backgroundColor:
                        '#660099',

                      borderColor:
                        '#4d0075',

                      borderWidth: 1,
                      borderRadius: 5
                    }
                  ]
                },

                options: {
                  responsive: true,
                  maintainAspectRatio: false,
                  indexAxis: 'y',

                  animation: {
                    duration: 450
                  },

                  interaction: {
                    mode: 'nearest',
                    intersect: false
                  },

                  plugins: {
                    legend: {
                      display: false
                    },

                    tooltip: {
                      callbacks: {
                        label: function (context) {
                          return (
                            'Quantidade: ' +
                            formatarQuantidade(
                              context.raw
                            )
                          );
                        }
                      }
                    }
                  },

                  scales: {
                    x: {
                      beginAtZero: true,

                      grid: {
                        color:
                          'rgba(108, 117, 125, 0.12)'
                      },

                      title: {
                        display: true,
                        text: 'Quantidade'
                      },

                      ticks: {
                        color: '#6c757d',
                        precision: 0,

                        callback: function (valor) {
                          return formatarQuantidade(
                            valor
                          );
                        }
                      }
                    },

                    y: {
                      grid: {
                        display: false
                      },

                      ticks: {
                        color: '#6c757d',
                        autoSkip: false
                      }
                    }
                  }
                }
              }
            );
        }

    function criarGraficoRosca(
      idCanvas,
      dados,
      cores,
      instanciaAtual
    ) {
      const canvas =
        document.getElementById(
          idCanvas
        );

      if (
        !canvas ||
        !Array.isArray(dados) ||
        dados.length === 0
      ) {
        return null;
      }

      destruirGraficoExistente(
        canvas,
        instanciaAtual
      );

      return new Chart(
        canvas,
        {
          type: 'doughnut',

          data: {
            labels:
              dados.map(
                function (item) {
                  return String(
                    item.label || ''
                  );
                }
              ),

            datasets: [
              {
                data:
                  dados.map(
                    function (item) {
                      return (
                        normalizarNumeroOuNull(
                          item.total
                        ) ?? 0
                      );
                    }
                  ),

                backgroundColor:
                  dados.map(
                    function (
                      item,
                      indice
                    ) {
                      return cores[
                        indice %
                        cores.length
                      ];
                    }
                  ),

                borderColor: '#ffffff',
                borderWidth: 3,
                hoverOffset: 6
              }
            ]
          },

          options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '62%',

            animation: {
              duration: 450
            },

            plugins: {
              legend: {
                display: true,
                position: 'bottom',

                labels: {
                  usePointStyle: true,
                  boxWidth: 9,
                  padding: 16
                }
              },

              tooltip: {
                callbacks: {
                  label: function (context) {
                    const valores =
                      context.dataset.data;

                    const total =
                      valores.reduce(
                        function (
                          soma,
                          valor
                        ) {
                          return (
                            soma +
                            (
                              normalizarNumeroOuNull(
                                valor
                              ) ?? 0
                            )
                          );
                        },
                        0
                      );

                    const valor =
                      normalizarNumeroOuNull(
                        context.raw
                      ) ?? 0;

                    const percentual =
                      total > 0
                        ? (
                            (
                              valor /
                              total
                            ) *
                            100
                          ).toLocaleString(
                            'pt-BR',
                            {
                              minimumFractionDigits:
                                1,

                              maximumFractionDigits:
                                1
                            }
                          )
                        : '0,0';

                    return (
                      context.label +
                      ': ' +
                      formatarQuantidade(
                        valor
                      ) +
                      ' (' +
                      percentual +
                      '%)'
                    );
                  }
                }
              }
            }
          }
        }
      );
    }

    function inicializarGraficosCausas() {
      graficoCausasResponsabilidade =
        criarGraficoRosca(
          'graficoCausasResponsabilidade',
          dadosCausasResponsabilidade,
          [
            '#cb2166',
            '#660099'
          ],
          graficoCausasResponsabilidade
        );

      graficoCausasPrioridade =
        criarGraficoRosca(
          'graficoCausasPrioridade',
          dadosCausasPrioridade,
          [
            '#0066ff',
            '#ff9200',
            '#660099'
          ],
          graficoCausasPrioridade
        );
    }

    function aplicarMascaraPeriodo() {
      const inputPeriodo =
        document.getElementById(
          'periodo'
        );

      if (!inputPeriodo) {
        return;
      }

      inputPeriodo.addEventListener(
        'input',
        function () {
          let valor =
            String(
              inputPeriodo.value || ''
            )
              .replace(/\D/g, '')
              .slice(0, 6);

          if (valor.length > 2) {
            valor =
              valor.slice(0, 2) +
              '/' +
              valor.slice(2);
          }

          inputPeriodo.value = valor;
        }
      );
    }

    function aplicarMascaraDdd() {
      const inputDdd =
        document.getElementById(
          'ddd'
        );

      if (!inputDdd) {
        return;
      }

      inputDdd.addEventListener(
        'input',
        function () {
          inputDdd.value =
            String(
              inputDdd.value || ''
            )
              .replace(/\D/g, '')
              .slice(0, 2);
        }
      );
    }

    function validarFormularioFiltros() {
      const formulario =
        document.getElementById(
          'filtros-inline'
        );

      const inputPeriodo =
        document.getElementById(
          'periodo'
        );

      if (
        !formulario ||
        !inputPeriodo
      ) {
        return;
      }

      formulario.addEventListener(
        'submit',
        function (evento) {
          const periodo =
            String(
              inputPeriodo.value || ''
            ).trim();

          if (
            periodo &&
            !/^(0[1-9]|1[0-2])\/\d{4}$/.test(
              periodo
            )
          ) {
            evento.preventDefault();

            inputPeriodo.setCustomValidity(
              'Informe um período válido no formato MM/AAAA.'
            );

            inputPeriodo.reportValidity();
            inputPeriodo.focus();

            return;
          }

          inputPeriodo.setCustomValidity(
            ''
          );
        }
      );

      inputPeriodo.addEventListener(
        'input',
        function () {
          inputPeriodo.setCustomValidity(
            ''
          );
        }
      );
    }

    function inicializarDashboardBaseline() {
      aplicarMascaraPeriodo();
      aplicarMascaraDdd();
      validarFormularioFiltros();

      if (
        typeof Chart === 'undefined'
      ) {
        console.error(
          '[Guardião Baseline] Chart.js não foi carregado.'
        );

        return;
      }

      inicializarGraficoEvolucao();
      inicializarGraficoRankingUf();
      inicializarGraficoRankingDdd();
      inicializarGraficoGapUf();
      inicializarGraficoTipoFalha();
      inicializarGraficosCausas();
    }

    if (
      document.readyState ===
      'loading'
    ) {
      document.addEventListener(
        'DOMContentLoaded',
        inicializarDashboardBaseline,
        {
          once: true
        }
      );
    } else {
      inicializarDashboardBaseline();
    }
  })();
</script>
@endsection